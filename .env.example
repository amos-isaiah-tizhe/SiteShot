PORT=3000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/onexp-siteshot?retryWrites=true&w=majority

# Session
SESSION_SECRET=your-super-secret-session-key-change-this

# App URL
APP_URL=http://localhost:3000

# Mail (Gmail App Password)
MAIL_USER=hello.onexportal@gmail.com
MAIL_PASS=your-gmail-app-password

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLIC_KEY=pk_test_xxxx

# ExchangeRate API
EXCHANGE_RATE_API_KEY=xxxx

# Cloudinary (optional — enables real imageUrl in API responses)
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# Redis (optional — enables screenshot queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
