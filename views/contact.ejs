<%- include('partials/header') %>

<div class="container-md section-py">
  <div class="page-header">
    <h1>Get in touch</h1>
    <p>Questions, partnerships or enterprise needs, we read every message.</p>
  </div>

  <div class="card mt-10" style="padding:1.75rem">

    <% if (sent) { %>
      <div class="success-box">
        <div class="success-icon">&#10003;</div>
        <h2>Message received</h2>
        <p>We'll reply within one business day.</p>
      </div>
    <% } else { %>

      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <% errors.forEach(e => { %><div><%= e.msg %></div><% }) %>
        </div>
      <% } %>

      <form action="/contact" method="POST" class="flex flex-col" style="gap:1rem">
        <div class="contact-form-grid">
          <div class="form-group">
            <label class="form-label" for="name">Name</label>
            <input id="name" name="name" type="text" required class="input-field" value="<%= old.name || '' %>" />
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input id="email" name="email" type="email" required class="input-field" value="<%= old.email || '' %>" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="subject">Subject</label>
          <input id="subject" name="subject" type="text" required class="input-field" value="<%= old.subject || '' %>" />
        </div>
        <div class="form-group">
          <label class="form-label" for="msg">Message</label>
          <textarea id="msg" name="message" required rows="5" class="input-field" placeholder="How can we help?"><%= old.message || '' %></textarea>
        </div>
        <div>
          <button type="submit" class="btn-primary">Send message</button>
        </div>
      </form>

    <% } %>
  </div>

  <p class="contact-email-note">
    Prefer email? Write to <a href="mailto:hello@onexportal.com">hello@onexportal.com</a>
  </p>
</div>

<%- include('partials/footer') %>
